# 本机私有配置模板 —— 复制成 local.env 后按需修改
#   cp scripts/local.env.example scripts/local.env
# local.env 已被 .gitignore 忽略，不会提交到仓库

# DevEco Studio 安装位置（不填则自动探测常见路径）
# Windows 下必须是 C:/ 盘符风格，不能写成 /c/...
export DEVECO_HOME="C:/Program Files/Huawei/DevEco Studio"

# 手表在局域网里的 IP（用于无线调试；端口由 lxconn.sh 自动探测）
export LX_WATCH_IP=192.168.1.100
